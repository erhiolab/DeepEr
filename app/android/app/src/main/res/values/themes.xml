<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nori" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nori_primary</item>
        <item name="colorPrimaryVariant">@color/nori_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/nori_primary</item>
        <item name="android:windowBackground">@color/nori_bg</item>
        <item name="android:statusBarColor">@color/nori_bg</item>
        <item name="android:navigationBarColor">@color/nori_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Nori.Fullscreen" parent="Theme.Nori">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
