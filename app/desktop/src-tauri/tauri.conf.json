{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DeepEr",
	"version": "0.1.0",
	"identifier": "cn.erhio.deeper",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "deeper",
				"title": "澄渊",
				"width": 300,
				"height": 300,
				"minWidth": 150,
				"minHeight": 300,
				"visible": false,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"alwaysOnTop": false,
				"skipTaskbar": false,
				"center": true,
				"devtools": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: deeper-asset: http://deeper-asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost deeper-asset: http://deeper-asset.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
			"dangerousDisableAssetCspModification": ["script-src"]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/erhiolab/DeepEr/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENzA4Q0UxNkMxQjE2NzEKUldSeEZodHM0WXh3UFlZMWpKZ2dkQWhNT3lUTXE4NEgyNDh3MzJuL3FyNjlPaTVLd3BxT0tHbkgK",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
